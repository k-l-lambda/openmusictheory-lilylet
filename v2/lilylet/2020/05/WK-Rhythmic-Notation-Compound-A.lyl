\staff "2" \stemUp c,4. \stemDown c'4 \stemUp c,8 | %3

\staff "1" \stemUp f8~[ f e] f4. \bar "|." \\
\staff "2" \stemUp f,,8[ a c] \stemDown f4. | %4

\staff "1" s8 s s s s s \\
\staff "2" s4. s | %5

\staff "1" s8 s s s4. \\
\staff "2" s8 s s s s s | %6

\staff "1" s8 s s s s s \\
\staff "2" s4. s4 s8 | %7

\staff "1" s8 s s s4. \bar "|." \\
\staff "2" s8 s s s4. | %8

\staff "1" \key c \major \time 9/8 \stemUp g'8^\markup "2"[ e g] a[ f a] \stemDown b[ a g] \\
\staff "2" R1 | %9

\staff "1" \stemUp e2 r8 r4 e8[ f] \\
\staff "2" R1 | %10

\staff "1" \stemUp g'4 e8 a g4 g8 a[ b] \\
\staff "2" R1 | %11

\staff "1" \stemUp a'4 g8 \stemDown b4 \stemUp a8 g a[ b] \\
\staff "2" R1 | %12

\staff "1" \stemDown c'4~ c8 r2. \bar "|." \\
\staff "2" R1 | %13

\staff "1" s8 s s s s s s s s \\
\staff "2" R1 | %14

\staff "1" s2 s8 s4 s8 s \\
\staff "2" R1 | %15

\staff "1" s4 s8 s s4 s8 s s \\
\staff "2" R1 | %16

\staff "1" s4 s8 s4 s8 s s s \\
\staff "2" R1 | %17

