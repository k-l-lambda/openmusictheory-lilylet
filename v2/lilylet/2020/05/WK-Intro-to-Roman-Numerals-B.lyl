\staff "2" \stemDown g4 e fs g | %9

\staff "1" \stemUp e'4 d c2 \\
\staff "1" \stemDown b'4 b b fs \\
\staff "2" \stemUp g'4 fs g e \\
\staff "2" \stemDown e,4 b e a, | %10

\staff "1" \stemUp b'2\breathe b4 b \\
\staff "1" \stemDown fs2 g4 fs \\
