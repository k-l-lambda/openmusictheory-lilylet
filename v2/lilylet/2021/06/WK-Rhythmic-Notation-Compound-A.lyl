[title "Rhythmic Notation: Compound"]
[staves "{s1-s2}"]

\staff "1" \key f \major \time 6/8 \clef "treble" \stemUp f8^\markup "1"[ g] a g^\markup "*" a[ bf] \\
\staff "2" \clef "bass" \stemDown f,4. \stemUp c | %1

\staff "1" \stemDown bf'8~ bf^\markup "*"[ g] \stemUp a4. \\
\staff "2" \stemUp f,,8[ a^\markup "*" c f^\markup "*" e d] | %2

\staff "1" \stemUp a'8 \stemDown bf^\markup "*" c bf \stemUp a^\markup "*"[ g] \\
\staff "2" \stemUp c,4. \stemDown c'4 \stemUp c,8 | %3

\staff "1" \stemUp f8^\markup "*"~[ f e] f4. \bar "|." \\
\staff "2" \stemUp f,,8 a^\markup "*" c \stemDown f4. | %4

\staff "1" \stemUp f8[ g a] \stemNeutral g a[ bf] \\
\staff "2" \stemDown f,4. \stemNeutral c | %5

\staff "1" bf'8~[ bf g] a4. \\
\staff "2" f,,8[ a c] f[ e d] | %6

\staff "1" a'8[ bf] c bf a[ g] \\
\staff "2" c,4. c'4 c,8 | %7

\staff "1" f8~[ f e] f4. \bar "|." \\
\staff "2" f,,8[ a c] f4. | %8

\staff "1" \key c \major \time 9/8 \stemUp g'8^\markup "2" e[ g] a^\markup "*" f a \stemDown b^\markup "*"[ a] \stemUp g \\
\staff "2" R1 | %9

\staff "1" \stemUp e2^\markup "*" r8 r4 e8^\markup "*"[ f] \\
\staff "2" R1 | %10

\staff "1" \stemUp g'4 e8 a g4 g8 a^\markup "*" \stemDown b \\
\staff "2" R1 | %11

\staff "1" \stemUp a'4 g8 \stemDown b4 \stemUp a8 g^\markup "*" a \stemDown b \\
\staff "2" R1 | %12

\staff "1" \stemDown c'4^\markup "*"~ c8 r2. \bar "|." \\
\staff "2" R1 | %13

\staff "1" \stemUp g'8[ e g] \stemNeutral a[ f a] b[ a g] \\
\staff "2" R1 | %14

\staff "1" \stemUp e4.~ e8 r r4 \stemNeutral e8[ f] \\
\staff "2" R1 | %15

\staff "1" g'4 e8 a g4 g8 a[ b] \\
\staff "2" R1 | %16

\staff "1" a'4 g8 b4 a8 g a[ b] \\
\staff "2" R1 | %17

\staff "1" c'4~ c8 r2. \bar "|." \\
\staff "2" R1 | %18

\staff "1" \key e \minor \time 12/8 \stemUp e8^\markup "3"[ ds] e fs^\markup "*" e[ fs] g2^\markup "*" fs8^\markup "*"[ e] \\
\staff "2" R1 | %19

\staff "1" \stemDown b'2^\markup "*"~ b4 r2. \\
\staff "2" R1 | %20

\staff "1" \stemDown c'4 \stemUp a8 \stemDown b4 \stemUp g8 a \stemDown b4 cs8^\markup "*" ds e \\
\staff "2" R1 | %21

\staff "1" \stemDown b'4^\markup "*"~ b8 \stemUp g4 fs8 e^\markup "*"^\markup "*" r r r4 r8 \bar "|." \\
\staff "2" R1 | %22

\staff "1" \stemUp e8[ ds e] \stemNeutral fs e[ fs] g2 fs8[ e] \\
\staff "2" R1 | %23

\staff "1" b'2~ b4 r2. \\
\staff "2" R1 | %24

\staff "1" c'4 a8 b4 g8 a b4 cs8[ ds e] \\
\staff "2" R1 | %25

\staff "1" b'4~ b8 g4 fs8 e r r r4 r8 \bar "|." \\
\staff "2" R1 | %26