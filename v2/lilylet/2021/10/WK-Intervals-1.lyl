[title "WK Intervals 1"]

\key c \major \clef "treble" <c a'>1^\markup "PART 1: Identification\nIdentify the following intervals by both quality (d, mi, ma, P, or A) and size (U, 2, 3, 4, 5, 6, 7, or 8)."^\markup "1" \bar "||" | %1

\clef "tenor" <e fs>1^\markup "2" \bar "||" | %2

\clef "alto" <a fs'>1^\markup "3" \bar "||" | %3

\clef "bass" <e f>1^\markup "4" \bar "||" | %4

\clef "tenor" <b f'>1^\markup "5" \bar "||" | %5

\clef "treble" <f e'>1^\markup "6" \bar "||" | %6

\clef "bass" <d d>1^\markup "7" \bar "||" | %7

\clef "alto" <e, g>1^\markup "8" \bar "||" | %8

\clef "tenor" <fs, d'>1^\markup "9" \bar "||" | %9

\clef "treble" <bf' e>1^\markup "10" \bar "||" | %10

g'1^\markup "PART 2: Intervals above a note\nAdd the correct note above the given note, to form the interval specified."^\markup "1" \bar "||" \addlyrics { ↑mi3 } | %11

\clef "alto" af1^\markup "2" \bar "||" \addlyrics { ↑A5 } | %12

\clef "tenor" e,1^\markup "3" \bar "||" \addlyrics { ↑mi6 } | %13

\clef "bass" b,1^\markup "4" \bar "||" \addlyrics { ↑P4 } | %14

df,1^\markup "5" \bar "||" \addlyrics { ↑ma6 } | %15

\clef "treble" f1^\markup "6" \bar "||" \addlyrics { ↑mi2 } | %16

\clef "alto" ef1^\markup "7" \bar "||" \addlyrics { ↑P5 } | %17

\clef "tenor" b1^\markup "8" \bar "||" \addlyrics { ↑ma7 } | %18

\clef "treble" ds1^\markup "9" \bar "||" \addlyrics { ↑mi7 } | %19

\clef "bass" af,1^\markup "10" \bar "||" \addlyrics { ↑ma3 } | %20

c1^\markup "PART 3: Intervals below a note\nAdd the correct note below the given note, to form the interval specified."^\markup "1" \bar "||" \addlyrics { ↓ma7 } | %21

\clef "treble" bf''1^\markup "2" \bar "||" \addlyrics { ↓P8 } | %22

f1^\markup "3" \bar "||" \addlyrics { ↓mi3 } | %23

\clef "bass" fs,1^\markup "4" \bar "||" \addlyrics { ↓P4 } | %24

\clef "treble" ef'1^\markup "5" \bar "||" \addlyrics { ↓ma6 } | %25

\clef "bass" e,1^\markup "6" \bar "||" \addlyrics { ↓P5 } | %26

\clef "alto" ef1^\markup "7" \bar "||" \addlyrics { ↓mi7 } | %27

\clef "tenor" c1^\markup "8" \bar "||" \addlyrics { ↓ma3 } | %28

\clef "bass" bf1^\markup "9" \bar "||" \addlyrics { ↓ma2 } | %29

\clef "alto" c1^\markup "10" \bar "||" \addlyrics { ↓mi2 } | %30