[title "WK Intervals 3"]

\key c \major \clef "bass" <a, c>1^\markup "1"^\markup "PART 1: Identification\nIdentify the following intervals by both quality (d, mi, ma, P, or A) and size (U, 2, 3, 4, 5, 6, 7, or 8)." \bar "||" | %1

\clef "treble" <fs e'>1^\markup "2" \bar "||" | %2

\clef "tenor" <cs, cs'>1^\markup "3" \bar "||" | %3

\clef "treble" <e' f>1^\markup "4" \bar "||" | %4

\clef "alto" <ef, c'>1^\markup "5" \bar "||" | %5

\clef "treble" <a' e'>1^\markup "6" \bar "||" | %6

\clef "tenor" <a ds>1^\markup "7" \bar "||" | %7

\clef "bass" <c, c>1^\markup "8" \bar "||" | %8

\clef "treble" <b' ds>1^\markup "9" \bar "||" | %9

\clef "bass" <d, bf'>1^\markup "10" \bar "||" | %10

\clef "treble" e1^\markup "1"^\markup "PART 2: Intervals above a pitch\nAdd the correct note above the given note, to form the interval specified." \bar "||" \addlyrics { ↑P5 } | %11

\clef "bass" d,1^\markup "2" \bar "||" \addlyrics { ↑ma7 } | %12

f,,1^\markup "3" \bar "||" \addlyrics { ↑mi3 } | %13

\clef "tenor" af1^\markup "4" \bar "||" \addlyrics { ↑P8 } | %14

\clef "alto" fs,1^\markup "5" \bar "||" \addlyrics { ↑mi6 } | %15

a1^\markup "6" \bar "||" \addlyrics { ↑ma2 } | %16

\clef "treble" gf'1^\markup "7" \bar "||" \addlyrics { ↑A5 } | %17

fs1^\markup "8" \bar "||" \addlyrics { ↑dim7 } | %18

\clef "bass" df,1^\markup "9" \bar "||" \addlyrics { ↑ma3 } | %19

\clef "tenor" gs1^\markup "10" \bar "||" \addlyrics { ↑P4 } | %20

g1^\markup "1"^\markup "PART 3: Intervals below a pitch\nAdd the correct note below the given note, to form the interval specified." \bar "||" \addlyrics { ↓ma3 } | %21

\clef "bass" bf1^\markup "2" \bar "||" \addlyrics { ↓d8 } | %22

\clef "alto" f,1^\markup "3" \bar "||" \addlyrics { ↓ma2 } | %23

\clef "tenor" cs1^\markup "4" \bar "||" \addlyrics { ↓ma7 } | %24

\clef "treble" af'1^\markup "5" \bar "||" \addlyrics { ↓mi6 } | %25

\clef "alto" f1^\markup "6" \bar "||" \addlyrics { ↓mi7 } | %26

\clef "bass" e,1^\markup "7" \bar "||" \addlyrics { ↓A4 } | %27

\clef "treble" b'1^\markup "8" \bar "||" \addlyrics { ↓ma6 } | %28

\clef "alto" bf'1^\markup "9" \bar "||" \addlyrics { ↓P5 } | %29

\clef "bass" a,1^\markup "10" \bar "||" \addlyrics { ↓mi2 } | %30