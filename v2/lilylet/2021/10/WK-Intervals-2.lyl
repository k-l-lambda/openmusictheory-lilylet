[title "WK Intervals 2"]

\key c \major \clef "tenor" <b c>1^\markup "PART 1: Identification\nIdentify the following intervals by both quality (d, mi, ma, P, or A) and size (U, 2, 3, 4, 5, 6, 7, or 8)."^\markup "1" \bar "||" | %1

\clef "alto" <as' e'>1^\markup "2" \bar "||" | %2

\clef "tenor" <a cs>1^\markup "3" \bar "||" | %3

\clef "treble" <a' f'>1^\markup "4" \bar "||" | %4

\clef "bass" <af d>1^\markup "5" \bar "||" | %5

\clef "alto" <e e'>1^\markup "6" \bar "||" | %6

\clef "treble" <f af>1^\markup "7" \bar "||" | %7

\clef "bass" <c, g'>1^\markup "8" \bar "||" | %8

<b, as'>1^\markup "9" \bar "||" | %9

\clef "treble" <cs fs>1^\markup "10" \bar "||" | %10

\clef "alto" a1^\markup "PART 2: Intervals above a note\nAdd the correct note above the given note, to form the interval specified."^\markup "1" \bar "||" \addlyrics { ↑mi2 } | %11

\clef "bass" a,1^\markup "2" \bar "||" \addlyrics { ↑ma6 } | %12

\clef "tenor" d,1^\markup "3" \bar "||" \addlyrics { ↑P4 } | %13

\clef "treble" e1^\markup "4" \bar "||" \addlyrics { ↑ma3 } | %14

\clef "bass" e,1^\markup "5" \bar "||" \addlyrics { ↑A4 } | %15

\clef "alto" fs1^\markup "6" \bar "||" \addlyrics { ↑P5 } | %16

\clef "treble" gs'1^\markup "7" \bar "||" \addlyrics { ↑mi7 } | %17

\clef "bass" fs,1^\markup "8" \bar "||" \addlyrics { ↑d3 } | %18

\clef "treble" fs1^\markup "9" \bar "||" \addlyrics { ↑mi6 } | %19

af'1^\markup "10" \bar "||" \addlyrics { ↑A8 } | %20

\clef "bass" f,1^\markup "PART 3: Intervals below a note\nAdd the correct note below the given note, to form the interval specified."^\markup "1" \bar "||" \addlyrics { ↓mi6 } | %21

\clef "alto" bf1^\markup "2" \bar "||" \addlyrics { ↓mi2 } | %22

\clef "tenor" d1^\markup "3" \bar "||" \addlyrics { ↓P5 } | %23

af'1^\markup "4" \bar "||" \addlyrics { ↓P8 } | %24

\clef "bass" cs1^\markup "5" \bar "||" \addlyrics { ↓mi7 } | %25

\clef "treble" c'1^\markup "6" \bar "||" \addlyrics { ↓ma3 } | %26

ef'1^\markup "7" \bar "||" \addlyrics { ↓ma7 } | %27

\clef "bass" b1^\markup "8" \bar "||" \addlyrics { ↓A4 } | %28

f,1^\markup "9" \bar "||" \addlyrics { ↓ma6 } | %29

\clef "treble" a'1^\markup "10" \bar "||" \addlyrics { ↓ma2 } | %30