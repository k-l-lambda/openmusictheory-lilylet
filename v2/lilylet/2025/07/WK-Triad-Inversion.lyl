[title "Triads and Seventh Chords"]
[subtitle "Triadic Inversion"]

\key c \major \clef "bass" <g, b e>1^\markup "1" \bar "||" | %1

\key g \major <e a c>1^\markup "2" \bar "||" | %2

\key d \major <a' d fs>1^\markup "3" \bar "||" | %3

\key bf \major <bf, d g>1^\markup "4" \bar "||" | %4

\key a \major <a cs e>1^\markup "5" \bar "||" | %5

\key af \major \clef "treble" <g' bf ef>1^\markup "6" \bar "||" | %6

\key f \major <e a c>1^\markup "7" \bar "||" | %7

\key e \major <e, a cs>1^\markup "8" \bar "||" | %8

\key ef \major <g bf ef>1^\markup "9" \bar "||" | %9

\key g \major <e,, a c>1^\markup "10" \bar "|." | %10

