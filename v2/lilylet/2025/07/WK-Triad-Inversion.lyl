[title "Triads and Seventh Chords"]
[subtitle "Triadic Inversion"]

\key c \major \clef "bass" <g, b e>1^\markup "1" \bar "||" | %1

\key g \major \clef "treble" <e a c>1^\markup "2" \bar "||" | %2

\key d \major <a' d fs>1^\markup "3" \bar "||" | %3

\key bf \major \clef "bass" <bf, d g>1^\markup "4" \bar "||" | %4

\key a \major \clef "alto" <a cs e>1^\markup "5" \bar "||" | %5

\key af \major \clef "treble" <g' bf ef>1^\markup "6" \bar "||" | %6

\key f \major <e a c>1^\markup "7" \bar "||" | %7

\key e \major \clef "tenor" <e, a cs>1^\markup "8" \bar "||" | %8

\key ef \major \clef "bass" <g bf ef>1^\markup "9" \bar "||" | %9

\key g \major <e,, a c>1^\markup "10" \bar "|." | %10

\clef "treble" s1 \bar "||" | %11

\clef "alto" s1 \bar "||" | %12

\clef "treble" s1 \bar "||" | %13

\clef "bass" s1 \bar "||" | %14

s1 \bar "||" | %15

\clef "treble" s1 \bar "||" | %16

\clef "tenor" s1 \bar "||" | %17

\clef "treble" s1 \bar "||" | %18

\clef "bass" s1 \bar "||" | %19

\clef "treble" s1 \bar "|." | %20