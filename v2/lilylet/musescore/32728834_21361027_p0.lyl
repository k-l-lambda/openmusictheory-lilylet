[staves "{-}"]
[title "MuseScore SVG import"]

\staff "1" \key b \major \numericTimeSignature \time 3/4 \clef "treble" r4 r4 <gs' b ds>4-. \\
\staff "2" \clef "bass" gs,8[ ds'8 gs8 b8 gs8 ds8] | %1

\staff "1" r4 r4 <a' b ds>4-. \\
\staff "2" fs,,8[ ds'8 fs8 b8 fs8 ds8] | %2

\staff "1" r4 r4 <a' bs ds>4-. \\
\staff "2" fs,,8[ ds'8 fs8 bs8 fs8 ds8] | %3

\staff "1" r4 r4 <as' cs e>4-. \\
\staff "2" fs,,8[ e'8 fs8 cs'8 fs,8 e8] | %4

\staff "1" r4 r4 <as' cs e>4-. \\
\staff "2" fs,,8[ e'8 fs8 cs'8 fs,8 e8] | %5

\staff "1" r4 r4 <as' cs e fs as>4-. \\
\staff "2" fs,,,8->[ fs'8 as8 cs8 e8 fs8] | %6

\staff "1" r4 r4 <cs' e fs as cs>4-. \\
\staff "2" \clef "treble" as8[ cs8 e8 fs8 as8] r8 | %7

\staff "1" <e' as cs e>4-. <e a cs e>2 \\
\staff "2" \clef "bass" <fs,, fs'>4-. <fss fss'>2-> | %8

\staff "1" <e' gs cs e>2 <e g cs e>4 \\
\staff "2" <gs, gs'>2-> <a a'>4-> | %9

\staff "1" <e' fs cs' e>2.~ \\
\staff "2" <as, fs' as>2.->~ | %10

\staff "1" <e' fs cs' e>2 <ds fs b ds>4 \\
\staff "2" <as, fs' as>2 <b fs' b>4 | %11

\staff "1" \stemUp gs''2. \\
\staff "1" \stemDown <ds' ds'>2 <cs cs'>4 \\
\staff "2" \stemUp <e,, e'>2 cs''4 \\
\staff "2" \stemDown s2 <e, gs>4~ | %12

\staff "1" <ds' ds'>4 <fs fs'>4-> <e e'>4 \\
\staff "2" \stemUp ds4 fs4-> e4 \\
\staff "2" \stemDown <e, gs>2. | %13

\staff "1" \stemUp fs'2. \\
\staff "1" \stemDown <b' b'>2 <b b'>8[ <cs cs'>8] \\
\staff "2" \stemUp ds2~ ds8[ e8] \\
\staff "2" \stemDown fs,2.~ | %14

\staff "1" <as' fs' as>4 r4 <fs fs'>4 \\
\staff "2" \stemUp cs4 r4 r4 \\
\staff "2" \stemDown fs,4 r4 r4 | %15

\staff "1" <fs' bs ds fs>4-. <fs b ds fs>2 \\
\staff "2" <gs, gs'>4-. <a a'>2-> | %16

\staff "1" <fs' as ds fs>2 <fs a ds fs>4 \\
\staff "2" <as, as'>2-> <b b'>4-> | %17

\staff "1" <fs' gs ds' fs>2. \\
\staff "2" <bs, gs' bs>2.-> | %18

\staff "1" <es' gs cs es>4 r4 <e gs cs e>4 \\
\staff "2" <cs, gs' cs>4 r4 r4 | %19
