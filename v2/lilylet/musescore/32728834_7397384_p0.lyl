[title "MuseScore SVG import"]

\staff "1" \key c \major \numericTimeSignature \time 5/8 \clef "treble" <d fs'>8-.[ <a' cs>8-.] <cs e>8-.[ <g b>8-. <g cs>8-.] \\
\staff "2" \clef "bass" <d, d'>8-.[ <fs cs'>8-.] a8-.[ e'8-. e,8-.] \\\
