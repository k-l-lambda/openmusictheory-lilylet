s1 \\\
s1 | %3

<g' bf>2 <g as>2 \\\
s1 | %4

\key d \major \stemUp as'2 b2 \\
\stemDown g'2 fs2 \\\
\stemUp cs2 b2 \\
\stemDown e,2 d2 | %5

\stemUp as'2 b2 \\
