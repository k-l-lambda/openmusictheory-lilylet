[staves ",{-}"]
[title "MuseScore SVG import"]

\key bf \major \numericTimeSignature \time 3/4 \clef "treble" \tempo "Andante" R1 \\\
\staff "1" \clef "treble" d8[ g8] bf,4 d8 \\
\staff "2" \clef "bass" <g, g'>4.~ bf'4 | %1

d'4 d4 d4 \\\
\staff "1" d8 s8 g8[ bf8] d,4 g8 \\
