\staff "2" \stemDown s2 s4 | %2

ef'2 d4 \\\
\staff "1" ef8[ g8 bf8] s8 ef,8[ g8] \\
\staff "2" \stemUp g,2. bf'4 \\
\staff "2" \stemDown s2 s4 | %3

cs'2 r4 \\\
\staff "1" bf8[ e8 g8 bf8 e,8 g8] \\
\staff "2" g2. | %4

d'4 a4 bf4 \\\
\staff "1" a8[ d8 fs8 a8 d,8 fs8] \\
\staff "2" fs,2. | %5

d'2 c4 \\\
\staff "1" a8[ d8 fs8 a8 d,8 fs8] \\
