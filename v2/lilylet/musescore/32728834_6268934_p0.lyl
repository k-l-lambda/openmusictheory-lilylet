\staff "2" \stemUp c2 \\
\staff "2" \stemDown f,2 | %2

\staff "1" s2 \\
\staff "2" s2 | %3

\staff "1" \key bf \major \stemUp bf'2 \\
\staff "1" \stemDown g'2 \\
\staff "2" \stemUp c2 \\
\staff "2" \stemDown e,2 | %4

\staff "1" \stemUp a'2 \\
