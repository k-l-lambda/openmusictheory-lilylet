[title "MuseScore SVG import"]

\staff "1" \key f \major \numericTimeSignature \time 2/4 \clef "treble" \stemUp bf'2 \\
\staff "1" \stemDown g'2 \\
\staff "2" \clef "bass" \stemUp c2 \\
\staff "2" \stemDown e,2 | %1

\staff "1" \stemUp a'2 \\
