[staves "{-}"]
[title "MuseScore SVG import"]

\staff "1" \key bf \major \numericTimeSignature \time 4/4 \clef "treble" <f g bf d>1 \\
\staff "2" \clef "bass" bf,1 | %1

\staff "1" <f g bf d>2 <e g bf d>2 \\
\staff "2" g,2 c2 | %2

\staff "1" <ef g bf d>2 <ef a d>2 \\
\staff "2" c,2 f,2 | %3

\staff "1" <d a' c>1 \\
\staff "2" bf,1 | %4
