[title "MuseScore SVG import"]

\staff "1" \key bf \major \numericTimeSignature \time 4/4 \clef "treble" \stemUp f4 g4 g4 a4 \\
\staff "1" \stemDown d4 f4 e4 g4 \\
\staff "2" \clef "bass" \stemUp bf4 b4 c4 cs4 \\
