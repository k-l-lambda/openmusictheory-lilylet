\staff "1" \stemUp a'4 b4 b4 b4 \\
\staff "1" \stemDown fs4 a4 gs4 gs4 \\
\staff "2" \stemUp d4 ds4 e4 d4 \\
\staff "2" \stemDown d,4 b4 e4 e4 | %2

\staff "1" <e a>1 \\
\staff "2" <a, cs'>1 | %3
