\staff "1" \stemDown <gf' bff>2 <f af>2 \\
\staff "2" eff,2 df2 | %3

\staff "1" \stemUp as'2 a2 \\
\staff "1" \stemDown <e g>2 <ds fs>2 \\
\staff "2" c,2 b2 | %4

\staff "1" \stemUp gs'2 g2 \\
\staff "1" \stemDown <d f>2 <cs e>2 \\
\staff "2" bf,2 a2 | %5

\staff "1" \stemUp fs2 f2 \\
