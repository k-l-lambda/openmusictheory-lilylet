\staff "1" \stemUp b'4. b4 b8 b4. gs8--[ a8-- b8--] s1 s8 \\
\staff "1" \stemDown <b d es>4. <b d fs>4. <b d gs>4. s1 s2 \\
\staff "2" <gs, gs'>4. <fs fs'>4. <es es'>4. r4. s1 s8 | %3

\staff "1" \stemUp b'4. b4 b8 b4. b4 b8 s1 s8 \\
