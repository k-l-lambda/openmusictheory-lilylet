\staff "1" \stemUp b'4 b8 b8 b4 b4 b8 b4 a8 s1 s8 \\
\staff "1" \stemDown <b d g>2. <cs g'>2. s1 s8 \\
\staff "2" <e,, e'>2. <e e'>4. <ef ef'>4. s1 s8 | %5

\staff "1" \tempo "Tempo primo" r4. <g a cs g' a>2. <g a cs g' a>4. s1 s8 \\
