\staff "1" \time 3/4 \stemUp g''8[ e8] f8->[ d8] df8->[ c8] \\
\staff "1" \stemDown <g' a e'>8 r8 <f bf>4-> <e bf'>4-> \\
\staff "2" \stemUp b8[ bf8] a8[ af8] g8[ gf8] \\
\staff "2" \stemDown b,8[ c8] cs8->[ d8] ds8->[ e8] | %9

\staff "1" \time 4/4 \stemUp <a' f'>8 r8 s4 r2 \\
