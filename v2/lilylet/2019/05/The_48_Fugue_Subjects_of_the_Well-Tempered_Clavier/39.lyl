[title "Bach, Well-Tempered Clavier II, Fugue 15 in G major, BWV 884: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key g \major \time 3/8 \clef "treble" r16 \stemDown d'[ b d g d] \\\
\clef "treble" s4. | %1

\stemDown b'16[ d g, d' b d] \\\
s4. | %2

\stemUp e'16[ c a c fs, a] \\\
s4. | %3

\stemUp d'16[ b g b e, g] \\\
s4. | %4

\stemUp c'16[ a fs a d, fs] \\\
s4. | %5

\stemUp b'16[ a g a b c] \\\
s4. | %6

\stemDown d'16[ a b cs d e] \\\
s4. | %7

fs'16 \bar "|." \\\
s4. \bar "|." | %8