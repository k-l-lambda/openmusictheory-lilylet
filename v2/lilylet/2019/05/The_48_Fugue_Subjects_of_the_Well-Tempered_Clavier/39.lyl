[title "Bach, Well-Tempered Clavier II, Fugue 15 in G major, BWV 884: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key g \major \time 3/8 \clef "treble" r16 \stemDown d'^\markup "BWV 884"[ b d g d] \\\
