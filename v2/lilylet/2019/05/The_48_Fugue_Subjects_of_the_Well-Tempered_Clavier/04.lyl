[title "Bach, Well-Tempered Clavier I, Fugue 4 in C# minor, BWV 849: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key e \major \time 2/2 \clef "bass" cs,1^\markup "BWV 849" \\\
\clef "bass" s1 | %1

\stemUp bs,2 \stemDown e \\\
s1 | %2

ds,1 \\\
s1 | %3

cs,4 \bar "|." \\\
s4 \bar "|." | %4