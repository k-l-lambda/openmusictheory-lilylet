[title "Bach, Well-Tempered Clavier II, Fugue 22 in Bb minor, BWV 891: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key df \major \time 3/2 \clef "treble" \stemUp bf2^\markup "BWV 891" c r4 df \\\
\clef "treble" s1. | %1

\stemUp ef4 a, bf2 r4 c \\\
s1. | %2

\stemUp df8[ bf c df] ef[ c df ef] f[ df ef f] \\\
s1. | %3

\stemUp gf'8[ ef] f4 r gf c, df8[ ef] \\\
s1. | %4

df4 s s2 s \bar "|." \\\
s1. \bar "|." | %5