[title "Bach, Well-Tempered Clavier I, Fugue 15 in G major, BWV 860: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key g \major \time 6/8 \clef "treble" \stemUp g'8^\markup "BWV 860"[ a16 g fs g] a8[ b16 a g a] \\\
