[title "Bach, Well-Tempered Clavier II, Fugue 18 in G# minor, BWV 887: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key b \major \time 6/8 \clef "treble" \stemUp gs'8^\markup "BWV 887"[ as b] as[ ds ds,] \\\
\clef "treble" s2. | %1

\stemUp gs'8[ b as] b[ as gs] \\\
s2. | %2

\stemUp as'8[ b cs] b[ e gs,] \\\
s2. | %3

\stemUp as'8[ cs b] cs[ b as] \\\
s2. | %4

b'4 s8 s4 s8 \bar "|." \\\
s2. \bar "|." | %5