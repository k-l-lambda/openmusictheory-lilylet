[title "Bach, Well-Tempered Clavier I, Fugue 8 in D# minor, BWV 853: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key fs \major \time 4/4 \clef "treble" \stemUp ds4^\markup "BWV 853" as'4. b8[ as gs] \\\
\clef "treble" R1 | %1

\stemUp fs8[ gs] as4 ds, gs~ \\\
R1 | %2

\stemUp gs'8[ fs] es4 \stemNeutral ds \bar "|." \\\
R1 \bar "|." | %3