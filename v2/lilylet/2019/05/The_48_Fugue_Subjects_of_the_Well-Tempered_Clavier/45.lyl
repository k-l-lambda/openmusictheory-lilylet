[title "Bach, Well-Tempered Clavier II, Fugue 21 in Bb major, BWV 890: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key bf \major \time 3/4 \clef "treble" r8 \stemUp c'[ bf a bf f] \\\
\clef "treble" s2. | %1

\stemUp d8[ g f ef f d] \\\
s2. | %2

\stemUp bf8[ ef ef( d) d( c)] \\\
s2. | %3

\stemUp c8[ f f( ef) ef( d)] \\\
s2. | %4

d8 \bar "|." \\\
s2. \bar "|." | %5