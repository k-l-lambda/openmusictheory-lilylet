[title "Bach, Well-Tempered Clavier II, Fugue 14 in F# minor, BWV 883: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key a \major \numericTimeSignature \time 4/4 \clef "bass" r4 r8 \stemDown cs a[ fs] d'4~ \\\
\clef "bass" s1 | %1

\stemDown d8[ cs16 b] cs4~ cs8[ fs] b,4~ \\\
s1 | %2

\stemDown b8[ a16 gs] a8[ fs] gs2 \\\
s1 | %3

fs,4 s8 \bar "|." \\\
s1 \bar "|." | %4