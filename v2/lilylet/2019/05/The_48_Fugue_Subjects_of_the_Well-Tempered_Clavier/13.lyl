[title "Bach, Well-Tempered Clavier I, Fugue 13 in F# major, BWV 858: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key fs \major \time 4/4 \clef "treble" r8 \stemDown cs'[ fs es] fs[ es16 ds] cs8.[ b32 cs] \\\
\clef "treble" s1 \\
s1 | %1

\stemDown ds'4 r8 cs \stemUp b[ as gs cs] \\\
s1 | %2

as'8 \bar "|." \\\
s1 \bar "|." | %3