[title "Bach, Well-Tempered Clavier II, Fugue 8 in D# minor, BWV 877: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key fs \major \numericTimeSignature \time 4/4 \clef "treble" r8 \stemUp ds[ ds ds] css[ ds] es4~ \\\
\clef "treble" s1 | %1

\stemUp es8[ ds] gs4. fs16[ es] as8[ gs] \\\
s1 | %2

fs8 \bar "|." \\\
s1 \bar "|." | %3