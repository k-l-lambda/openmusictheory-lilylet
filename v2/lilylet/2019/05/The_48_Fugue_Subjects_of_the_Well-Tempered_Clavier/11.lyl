[title "Bach, Well-Tempered Clavier I, Fugue 11 in F major, BWV 856: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key f \major \time 3/8 \clef "treble" \stemUp c8^\markup "BWV 856" \\\
