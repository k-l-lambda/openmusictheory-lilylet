[title "Bach, Well-Tempered Clavier II, Fugue 24 in B minor, BWV 893: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key d \major \time 3/8 \clef "treble" r4 \stemUp fs8 \\\
\clef "treble" s4. | %1

\stemUp d8[ b as] \\\
s4. | %2

\stemUp b8[ cs16 d e fs] \\\
s4. | %3

\stemUp g'8[ g, g'] \\\
s4. | %4

\stemUp fs8[ fs, fs'] \\\
s4. | %5

\stemUp e8[ fs16 e d cs] \\\
s4. | %6

\stemUp d16[ fs e d cs b] \bar "|." \\\
s4. \bar "|." | %7