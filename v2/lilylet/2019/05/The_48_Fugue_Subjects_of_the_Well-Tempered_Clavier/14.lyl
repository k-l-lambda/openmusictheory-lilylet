[title "Bach, Well-Tempered Clavier I, Fugue 14 in F# minor, BWV 859: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key a \major \time 6/4 \clef "bass" r4 \stemDown fs, gs a2.~ \\\
\clef "bass" s1. | %1

\stemDown a4 gs8[ as] b4~ b as8[ gs as bs] \\\
s1. | %2

\stemDown cs4. b8[ a cs] b[ a] gs2 \\\
s1. | %3

fs,4 \bar "|." \\\
s1. \bar "|." | %4