[title "Bach, Well-Tempered Clavier I, Fugue 23 in B major, BWV 868: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key b \major \numericTimeSignature \time 4/4 \clef "treble" r8 \stemUp b[ as b] cs4 fs,8[ gs16 as] \\\
\clef "treble" s1 | %1

\stemUp b8[ cs16 ds] e8[ ds] cs2 \\\
s1 | %2

b8 \bar "|." \\\
s1 \bar "|." | %3