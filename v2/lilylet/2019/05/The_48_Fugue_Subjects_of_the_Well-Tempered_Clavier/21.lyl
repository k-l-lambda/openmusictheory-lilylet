[title "Bach, Well-Tempered Clavier I, Fugue 21 in Bb major, BWV 866: subject"]
[subtitle "Task: Use the empty stave to write suitable answers and counter-subjects"]
[composer "J. S. Bach"]
[staves "s1,s2"]

\key bf \major \time 3/4 \clef "treble" r8 \stemUp f^\markup "BWV 866" g[ f] bf[ d,] \\\
